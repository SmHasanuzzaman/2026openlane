digraph "inverter" {
label="inverter";
rankdir="LR";
remincross=true;
n2 [ shape=octagon, label="clk", color="black", fontcolor="black"];
n3 [ shape=octagon, label="in", color="black", fontcolor="black"];
n4 [ shape=octagon, label="out", color="black", fontcolor="black"];
c7 [ shape=record, label="{{<p5> A}|$84\n$_NOT_|{<p6> Y}}",  ];
c11 [ shape=record, label="{{<p8> C|<p9> D}|$81\n$_DFF_P_|{<p10> Q}}",  ];
c7:p6:e -> c11:p9:w [color="black", fontcolor="black", label=""];
n2:e -> c11:p8:w [color="black", fontcolor="black", label=""];
n3:e -> c7:p5:w [color="black", fontcolor="black", label=""];
c11:p10:e -> n4:w [color="black", fontcolor="black", label=""];
}
